{
  "appId": "com.jjs.erp",
  "productName": "JJ's ERP",
  "files": ["electron/client.cjs", "dist/web/logo.png", "package.json", "!node_modules/**/*"],
  "extraMetadata": { "name": "jjs-erp", "main": "electron/client.cjs" },
  "npmRebuild": false,
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
  "directories": { "buildResources": "build", "output": "release/client" },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "JJ's ERP"
  }
}
