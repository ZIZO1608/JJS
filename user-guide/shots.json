{
 "base_url": "http://127.0.0.1:4396",
 "display_base_url": "JJ's ERP",
 "viewport": {
  "width": 1000,
  "height": 760
 },
 "device_scale_factor": 2,
 "delay_ms": 400,
 "hide": [
  "[role=status]",
  ".toast"
 ],
 "login": {
  "url": "/",
  "actions": [
   {
    "fill": {
     "selector": "#login-user",
     "value": "jabal"
    }
   },
   {
    "fill": {
     "selector": "#login-pass",
     "value": "jabal123"
    }
   },
   {
    "press": "Enter"
   },
   {
    "wait_for": "header"
   }
  ]
 },
 "languages": {
  "ar": {
   "setup": [
    {
     "click": "header button:text-is('عربي')"
    },
    {
     "wait_for": "html[dir=rtl]"
    }
   ],
   "locale": "ar-SY"
  },
  "en": {
   "setup": [
    {
     "click": "header button:text-is('EN')"
    },
    {
     "wait_for": "html[dir=ltr]"
    }
   ],
   "locale": "en-GB"
  }
 },
 "screens": [
  {
   "id": "login",
   "url": "/",
   "actions": [
    {
     "eval": "fetch('/api/auth/logout', {method: 'POST'}).then(() => location.assign('/'))"
    },
    {
     "wait": 900
    },
    {
     "wait_for": "#login-user"
    }
   ],
   "clip": "div:has(> form)",
   "clip_padding": 20,
   "callouts": [
    {
     "key": "user",
     "selector": "#login-user"
    },
    {
     "key": "pass",
     "selector": "#login-pass"
    },
    {
     "key": "go",
     "selector": "form .btn-primary"
    }
   ]
  },
  {
   "id": "home",
   "url": null,
   "actions": [
    {
     "fill": {
      "selector": "#login-user",
      "value": "jabal"
     }
    },
    {
     "fill": {
      "selector": "#login-pass",
      "value": "jabal123"
     }
    },
    {
     "press": "Enter"
    },
    {
     "wait_for": "header"
    },
    {
     "goto": "/"
    }
